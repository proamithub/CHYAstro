                                    </div>
                                </div>

                                <button type="submit" class="btn btn-cosmic-gold w-100 py-2 mb-2">
                                    <i class="bi bi-stars me-1"></i> ✨ खाता बनाएं एवं 3 मुफ़्त स्कैन पाएं ✨

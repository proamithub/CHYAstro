@page "/Admin/AppSimulator"
@model CyhAstro.Admin.Pages.Admin.AppSimulatorModel
@{
    ViewData["Title"] = "📱 Live Mobile App Tester";
    ViewData["ActivePage"] = "AppSimulator";
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
}

<style>
    /* Phone frame simulation */
    .phone-mockup {
        width: 400px;
        max-width: 100%;
        min-height: 760px;
        background: #0d0820;
        border: 12px solid #201738;
        border-radius: 46px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(124, 58, 237, 0.25);
        margin: 0 auto;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .phone-notch {
        width: 140px;
        height: 24px;
        background: #201738;
        margin: 0 auto;
        border-bottom-left-radius: 16px;
        border-bottom-right-radius: 16px;
        position: relative;
        z-index: 10;
    }
    .phone-screen {
        flex: 1;
        padding: 16px;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        max-height: 700px;
    }
    .phone-header {
        text-align: center;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 12px;
    }
    .phone-bottom-nav {
        display: flex;
        justify-content: space-around;
        background: rgba(18, 13, 42, 0.95);
        border-top: 1px solid var(--border-color);
        padding: 10px 4px 14px;
    }
    .nav-tab-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 0.65rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        text-decoration: none;
        transition: all 0.2s;
    }
    .nav-tab-btn i { font-size: 1.15rem; }
    .nav-tab-btn.active { color: var(--accent-gold); font-weight: 600; }
    .nav-tab-btn:hover { color: var(--text-primary); }

    .test-badge {
        font-size: 0.65rem;
        padding: 3px 8px;
        border-radius: 12px;
    }
</style>

@if (!string.IsNullOrEmpty(Model.AlertMessage))
{
    <div class="alert-cosmic mb-3 p-3 @(Model.AlertSuccess ? "" : "border-danger text-danger")" role="alert">
        @(Model.AlertSuccess ? "✨ " : "⚠️ ") @Model.AlertMessage
    </div>
}

<div class="row g-4">
    <!-- LEFT: Interactive Smartphone Simulator -->
    <div class="col-lg-5 col-xl-4 text-center">
        <div class="phone-mockup text-start">
            <div class="phone-notch"></div>
            
            <!-- Phone Header -->
            <div class="phone-screen">
                <div class="phone-header">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span style="font-size:0.7rem; color:var(--text-muted);"><i class="bi bi-clock me-1"></i>@(DateTime.Now.ToString("hh:mm tt"))</span>
                        <a href="/Admin/AppSimulator?tab=auth" class="badge @(Model.TestUserProfile?.Plan == "Free" ? "bg-secondary" : "bg-warning text-dark") test-badge text-decoration-none">
                            @(Model.TestUserProfile?.Plan ?? "Free") Plan <i class="bi bi-arrow-right-short"></i>
                        </a>
                        <span style="font-size:0.7rem; color:var(--accent-green);"><i class="bi bi-battery-full"></i> 100%</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2 px-1">
                        <div class="text-start">
                            <div style="font-family:'Cinzel', serif; font-size:1rem; color:var(--accent-gold); font-weight:700;">
                                ✦ CYHASTRO ✦
                            </div>
                            <div style="font-size:0.68rem; color:var(--text-muted);">
                                User: <strong class="text-light">@(Model.TestUserProfile?.FullName ?? "Not Logged In")</strong>
                            </div>
                        </div>
                        <a href="/Admin/AppSimulator?tab=auth" class="btn btn-outline-warning btn-sm py-0 px-2" style="font-size:0.65rem;">
                            <i class="bi bi-person-circle me-1"></i>Login / Switch
                        </a>
                    </div>

                    <div class="mt-2 d-flex justify-content-center gap-2">
                        <span class="badge bg-dark border border-secondary" style="font-size:0.65rem;">
                            ✋ Palm: <strong>@(Model.TestUserProfile?.PalmScansRemaining ?? 0)</strong>
                        </span>
                        <span class="badge bg-dark border border-secondary" style="font-size:0.65rem;">
                            👤 Face: <strong>@(Model.TestUserProfile?.FaceScansRemaining ?? 0)</strong>
                        </span>
                    </div>
                </div>

                <!-- TAB 1: PALM SCANNER -->
                @if (Model.ActiveTab == "palm")
                {
                    <div>
                        <div class="text-center mb-3">
                            <h6 style="color:var(--accent-gold); font-size:0.95rem; margin-bottom:4px;">
                                ✋ हस्तरेखा स्कैनर (Palmistry Vision AI)
                            </h6>
                            <p style="font-size:0.72rem; color:var(--text-muted); margin:0;">
                                Apni hatheli ki asli photo choose karein. Gemini Vision AI image ke pixels scan karega.
                            </p>
                        </div>

                        <form method="post" asp-page-handler="ScanPalm" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="mb-3 text-center">
                                <label class="form-label" style="font-size:0.72rem; color:var(--text-muted);">SELECT HAND</label>
                                <div class="d-flex justify-content-center gap-3">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="handSide" id="handRight" value="Right" checked>
                                        <label class="form-check-label" for="handRight" style="font-size:0.8rem;">Right (दायां)</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="handSide" id="handLeft" value="Left">
                                        <label class="form-check-label" for="handLeft" style="font-size:0.8rem;">Left (बायां)</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-warning fw-bold" style="font-size:0.72rem;">
                                    <i class="bi bi-camera-fill me-1"></i>CHOOSE PALM IMAGE (REQUIRED)
                                </label>
                                <input type="file" name="palmImage" accept="image/jpeg,image/png,image/webp" class="form-control cosmic-input form-control-sm" required />
                                <small class="text-muted d-block mt-1" style="font-size:0.68rem;">
                                    ⚠️ Bina photo upload kiye AI analyze nahi karega. Real photo select karein.
                                </small>
                            </div>

                            <button type="submit" class="btn btn-gold w-100 py-2 mb-3">
                                <i class="bi bi-camera me-1"></i> Upload & Analyze with Gemini AI
                            </button>
                        </form>

                        @if (Model.PalmResult != null)
                        {
                            <div class="cosmic-card p-3 mb-2" style="background:rgba(20, 14, 45, 0.9);">
                                @if (!string.IsNullOrEmpty(Model.UploadedImageUrl))
                                {
                                    <div class="text-center mb-2">
                                        <img src="@Model.UploadedImageUrl" class="rounded border border-warning" style="max-height:120px; max-width:100%; object-fit:cover;" alt="Uploaded Palm" />
                                        <div style="font-size:0.65rem; color:var(--text-muted); margin-top:3px;">Analyzed Image</div>
                                    </div>
                                }

                                <div class="fw-bold mb-2 text-gold text-center" style="font-size:0.85rem;">✦ Google Gemini AI Analysis ✦</div>

                                <div class="mb-2 pb-2 border-bottom border-dark">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span style="font-size:0.75rem; color:var(--accent-green);">जीवन रेखा (Life Line)</span>
                                        <span class="badge bg-success" style="font-size:0.65rem;">@Model.PalmResult.LifeLine.Strength</span>
                                    </div>
                                    <p style="font-size:0.72rem; color:var(--text-primary); margin:2px 0;">@Model.PalmResult.LifeLine.Summary</p>
                                </div>

                                <div class="mb-2 pb-2 border-bottom border-dark">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span style="font-size:0.75rem; color:var(--accent-teal);">मस्तिष्क रेखा (Head Line)</span>
                                        <span class="badge bg-info" style="font-size:0.65rem;">@Model.PalmResult.HeadLine.Strength</span>
                                    </div>
                                    <p style="font-size:0.72rem; color:var(--text-primary); margin:2px 0;">@Model.PalmResult.HeadLine.Summary</p>
                                </div>

                                <div class="mb-2 pb-2 border-bottom border-dark">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span style="font-size:0.75rem; color:#ef4444;">हृदय रेखा (Heart Line)</span>
                                        <span class="badge bg-danger" style="font-size:0.65rem;">@Model.PalmResult.HeartLine.Strength</span>
                                    </div>
                                    <p style="font-size:0.72rem; color:var(--text-primary); margin:2px 0;">@Model.PalmResult.HeartLine.Summary</p>
                                </div>

                                <div class="mb-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span style="font-size:0.75rem; color:var(--accent-gold);">भाग्य रेखा (Fate Line)</span>
                                        @if (Model.PalmResult.FateLine.IsLocked)
                                        {
                                            <span class="badge bg-warning text-dark" style="font-size:0.65rem;">🔒 Locked (Premium)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark" style="font-size:0.65rem;">@Model.PalmResult.FateLine.Strength</span>
                                        }
                                    </div>
                                    <p style="font-size:0.72rem; color:var(--text-primary); margin:2px 0;">@Model.PalmResult.FateLine.Summary</p>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- TAB 2: FACE SCANNER -->
                @if (Model.ActiveTab == "face")
                {
                    <div>
                        <div class="text-center mb-3">
                            <h6 style="color:var(--accent-gold); font-size:0.95rem; margin-bottom:4px;">
                                👤 सामुद्रिक शास्त्र (Face Reading AI)
                            </h6>
                            <p style="font-size:0.72rem; color:var(--text-muted); margin:0;">
                                Chehre ya selfie ki photo choose karein. AI facial zones analyze karega.
                            </p>
                        </div>

                        <form method="post" asp-page-handler="ScanFace" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label text-warning fw-bold" style="font-size:0.72rem;">
                                    <i class="bi bi-camera-fill me-1"></i>CHOOSE FACE PHOTO (REQUIRED)
                                </label>
                                <input type="file" name="faceImage" accept="image/jpeg,image/png,image/webp" class="form-control cosmic-input form-control-sm" required />
                                <small class="text-muted d-block mt-1" style="font-size:0.68rem;">
                                    ⚠️ Photo zaroori hai. Image select karke hi scan chalega.
                                </small>
                            </div>

                            <button type="submit" class="btn btn-gold w-100 py-2 mb-3">
                                <i class="bi bi-person-bounding-box me-1"></i> Upload & Read Face
                            </button>
                        </form>

                        @if (Model.FaceResult != null)
                        {
                            <div class="cosmic-card p-3 mb-2" style="background:rgba(20, 14, 45, 0.9);">
                                @if (!string.IsNullOrEmpty(Model.UploadedImageUrl))
                                {
                                    <div class="text-center mb-2">
                                        <img src="@Model.UploadedImageUrl" class="rounded border border-warning" style="max-height:120px; max-width:100%; object-fit:cover;" alt="Uploaded Face" />
                                        <div style="font-size:0.65rem; color:var(--text-muted); margin-top:3px;">Analyzed Face Image</div>
                                    </div>
                                }

                                <div class="fw-bold mb-2 text-gold text-center" style="font-size:0.85rem;">✦ Samudrik Shastra Insights ✦</div>

                                <div class="mb-2 pb-2 border-bottom border-dark">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span style="font-size:0.75rem; color:var(--accent-gold);">मस्तक (Forehead / Intellect)</span>
                                        <span class="badge bg-warning text-dark" style="font-size:0.65rem;">@Model.FaceResult.Forehead?.Trait</span>
                                    </div>
                                    <p style="font-size:0.72rem; color:var(--text-primary); margin:2px 0;">@Model.FaceResult.Forehead?.Summary</p>
                                </div>

                                <div class="mb-2 pb-2 border-bottom border-dark">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span style="font-size:0.75rem; color:var(--accent-teal);">नयन (Eyes / Soul)</span>
                                        <span class="badge bg-info" style="font-size:0.65rem;">@Model.FaceResult.Eyes?.Trait</span>
                                    </div>
                                    <p style="font-size:0.72rem; color:var(--text-primary); margin:2px 0;">@Model.FaceResult.Eyes?.Summary</p>
                                </div>

                                <div class="mb-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span style="font-size:0.75rem; color:var(--accent-green);">नासिका (Nose / Wealth)</span>
                                        <span class="badge bg-success" style="font-size:0.65rem;">@Model.FaceResult.Nose?.Trait</span>
                                    </div>
                                    <p style="font-size:0.72rem; color:var(--text-primary); margin:2px 0;">@Model.FaceResult.Nose?.Summary</p>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- TAB 3: JANAM KUNDLI -->
                @if (Model.ActiveTab == "kundli")
                {
                    <div>
                        <div class="text-center mb-3">
                            <h6 style="color:var(--accent-gold); font-size:0.95rem; margin-bottom:4px;">
                                🔮 वैदिक जन्म कुंडली (Vedic Chart)
                            </h6>
                            <p style="font-size:0.72rem; color:var(--text-muted); margin:0;">
                                100% Free Astronomical Math Engine (No Paid API).
                            </p>
                        </div>

                        <form method="post" asp-page-handler="CalculateKundli">
                            @Html.AntiForgeryToken()
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">DOB</label>
                                    <input type="date" name="dob" value="1995-08-15" class="form-control cosmic-input form-control-sm" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">TIME</label>
                                    <input type="time" name="tob" value="14:30" class="form-control cosmic-input form-control-sm" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">CITY / PLACE OF BIRTH</label>
                                <input type="text" name="city" value="New Delhi, India" class="form-control cosmic-input form-control-sm" />
                            </div>

                            <button type="submit" class="btn btn-gold w-100 py-2 mb-3">
                                <i class="bi bi-stars me-1"></i> Calculate Vedic Kundli
                            </button>
                        </form>

                        @if (Model.KundliResult != null)
                        {
                            <div class="cosmic-card p-3 mb-2" style="background:rgba(20, 14, 45, 0.9);">
                                <div class="fw-bold mb-2 text-gold text-center" style="font-size:0.85rem;">✦ लग्न व ग्रह स्थिति ✦</div>
                                <div class="row g-2 text-center mb-2">
                                    <div class="col-4 p-1">
                                        <div class="p-2 border border-secondary rounded">
                                            <div style="font-size:0.65rem; color:var(--text-muted);">लग्न (Ascendant)</div>
                                            <div class="fw-bold text-gold" style="font-size:0.75rem;">@Model.KundliResult.LagnaRashi</div>
                                        </div>
                                    </div>
                                    <div class="col-4 p-1">
                                        <div class="p-2 border border-secondary rounded">
                                            <div style="font-size:0.65rem; color:var(--text-muted);">चंद्र (Moon)</div>
                                            <div class="fw-bold text-teal" style="font-size:0.75rem;">@Model.KundliResult.MoonRashi</div>
                                        </div>
                                    </div>
                                    <div class="col-4 p-1">
                                        <div class="p-2 border border-secondary rounded">
                                            <div style="font-size:0.65rem; color:var(--text-muted);">नक्षत्र (Star)</div>
                                            <div class="fw-bold text-green" style="font-size:0.75rem;">@Model.KundliResult.Nakshatra</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="p-2 rounded bg-dark border border-secondary mb-2" style="font-size:0.72rem;">
                                    <div class="d-flex justify-content-between">
                                        <span>विंशोत्तरी महादशा:</span>
                                        <strong class="text-warning">@Model.KundliResult.MahadashaCurrent</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1">
                                        <span>मांगलिक दोष (Manglik):</span>
                                        <strong class="@(Model.KundliResult.IsManglik ? "text-danger" : "text-success")">
                                            @(Model.KundliResult.IsManglik ? "हाँ (Manglik Active)" : "नहीं (No Manglik)")
                                        </strong>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1">
                                        <span>साढ़े साती (Sade Sati):</span>
                                        <strong class="@(Model.KundliResult.SadeSatiActive ? "text-danger" : "text-success")">
                                            @(Model.KundliResult.SadeSatiActive ? "सक्रिय (Active)" : "नहीं (Inactive)")
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- TAB 4: WALLET & UPGRADE -->
                @if (Model.ActiveTab == "wallet")
                {
                    <div>
                        <div class="text-center mb-3">
                            <h6 style="color:var(--accent-gold); font-size:0.95rem; margin-bottom:4px;">
                                💳 सब्सक्रिप्शन व वॉलेट (Subscription)
                            </h6>
                            <p style="font-size:0.72rem; color:var(--text-muted); margin:0;">
                                Test user ke plan ko upgrade karein aur credits check karein.
                            </p>
                        </div>

                        <div class="cosmic-card p-3 mb-3" style="background:rgba(20, 14, 45, 0.9);">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span style="font-size:0.75rem; color:var(--text-muted);">Active Plan:</span>
                                <span class="badge bg-warning text-dark fs-6">@(Model.TestUserProfile?.Plan ?? "Free")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span style="font-size:0.75rem; color:var(--text-muted);">Palm Scans Balance:</span>
                                <span class="fw-bold text-gold">@(Model.TestUserProfile?.PalmScansRemaining ?? 0) Scans</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span style="font-size:0.75rem; color:var(--text-muted);">Face Scans Balance:</span>
                                <span class="fw-bold text-teal">@(Model.TestUserProfile?.FaceScansRemaining ?? 0) Scans</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" style="font-size:0.72rem; color:var(--text-muted);">1-CLICK UPGRADE TEST</label>
                            <div class="d-grid gap-2">
                                <form method="post" asp-page-handler="Upgrade">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="plan" value="Weekly" />
                                    <button type="submit" class="btn btn-outline-info w-100 btn-sm">
                                        Upgrade to Weekly (₹99)
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Upgrade">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="plan" value="Monthly" />
                                    <button type="submit" class="btn btn-outline-warning w-100 btn-sm">
                                        Upgrade to Monthly (₹299)
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Upgrade">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="plan" value="Lifetime" />
                                    <button type="submit" class="btn btn-gold w-100 btn-sm">
                                        Upgrade to Lifetime (Unlimited)
                                    </button>
                                </form>
                            </div>
                        </div>

                        <form method="post" asp-page-handler="ResetCredits">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset to Free (3 Scans)
                            </button>
                        </form>
                    </div>
                }

                <!-- TAB 5: AUTH & USER LOGIN (NEW!) -->
                @if (Model.ActiveTab == "auth")
                {
                    <div>
                        <div class="text-center mb-3">
                            <h6 style="color:var(--accent-gold); font-size:0.95rem; margin-bottom:4px;">
                                👤 यूजर लॉगिन व खाता (User Authentication)
                            </h6>
                            <p style="font-size:0.72rem; color:var(--text-muted); margin:0;">
                                App me naye ya purane user account se login karein.
                            </p>
                        </div>

                        <!-- Current Logged In Profile Box -->
                        @if (Model.TestUserProfile != null)
                        {
                            <div class="cosmic-card p-3 mb-3 border-success" style="background:rgba(20, 14, 45, 0.9);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-success" style="font-size:0.65rem;">Active Logged-In User</span>
                                    <form method="post" asp-page-handler="Logout" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link text-danger p-0 text-decoration-none" style="font-size:0.7rem;">
                                            <i class="bi bi-box-arrow-right"></i> Log Out
                                        </button>
                                    </form>
                                </div>
                                <div class="fw-bold text-light" style="font-size:0.88rem;">@Model.TestUserProfile.FullName</div>
                                <div style="font-size:0.7rem; color:var(--text-muted);">Email: @(Model.TestUserProfile.Email ?? "None")</div>
                                <div style="font-size:0.7rem; color:var(--text-muted);">Phone: @(Model.TestUserProfile.PhoneNumber ?? "None")</div>
                                <div style="font-size:0.7rem; color:var(--text-muted);">DOB: @Model.TestUserProfile.DateOfBirth</div>

                                @if (!string.IsNullOrEmpty(Model.GeneratedJwtToken))
                                {
                                    <div class="mt-2 p-2 rounded bg-black border border-secondary">
                                        <div style="font-size:0.62rem; color:var(--accent-gold);">JWT Bearer Token:</div>
                                        <div style="font-size:0.62rem; word-break:break-all; font-family:monospace; color:#aaa;">
                                            @(Model.GeneratedJwtToken.Length > 60 ? Model.GeneratedJwtToken[..60] + "..." : Model.GeneratedJwtToken)
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Login Form -->
                        <div class="cosmic-card p-3 mb-3" style="background:rgba(20, 14, 45, 0.8);">
                            <div class="fw-bold text-gold mb-2" style="font-size:0.8rem;">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login With Existing Account
                            </div>
                            <form method="post" asp-page-handler="Login">
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">EMAIL OR PHONE</label>
                                    <input type="text" name="emailOrPhone" value="tester@cyhastro.com" class="form-control cosmic-input form-control-sm" required />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">PASSWORD</label>
                                    <input type="password" name="password" value="Test@123" class="form-control cosmic-input form-control-sm" required />
                                </div>
                                <button type="submit" class="btn btn-gold w-100 btn-sm">
                                    <i class="bi bi-door-open me-1"></i> Log In to App
                                </button>
                            </form>
                        </div>

                        <!-- Register New User Form -->
                        <div class="cosmic-card p-3 mb-2" style="background:rgba(20, 14, 45, 0.8);">
                            <div class="fw-bold text-teal mb-2" style="font-size:0.8rem;">
                                <i class="bi bi-person-plus me-1"></i>Register New Test User
                            </div>
                            <form method="post" asp-page-handler="Register">
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">FULL NAME</label>
                                    <input type="text" name="fullName" placeholder="Rahul Verma" class="form-control cosmic-input form-control-sm" required />
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">EMAIL</label>
                                        <input type="email" name="email" placeholder="rahul@example.com" class="form-control cosmic-input form-control-sm" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">PHONE</label>
                                        <input type="tel" name="phone" placeholder="+919811223344" class="form-control cosmic-input form-control-sm" />
                                    </div>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">PASSWORD</label>
                                        <input type="password" name="password" value="Pass@123" class="form-control cosmic-input form-control-sm" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label" style="font-size:0.68rem; color:var(--text-muted);">DOB</label>
                                        <input type="date" name="dob" value="1998-05-20" class="form-control cosmic-input form-control-sm" />
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-outline-info w-100 btn-sm">
                                    <i class="bi bi-person-check me-1"></i> Create Account & Get 3 Free Scans
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <!-- Phone Bottom Navigation Bar -->
            <div class="phone-bottom-nav">
                <a href="/Admin/AppSimulator?tab=palm" class="nav-tab-btn @(Model.ActiveTab == "palm" ? "active" : "")">
                    <i class="bi bi-hand-index-thumb"></i>
                    <span>Palm</span>
                </a>
                <a href="/Admin/AppSimulator?tab=face" class="nav-tab-btn @(Model.ActiveTab == "face" ? "active" : "")">
                    <i class="bi bi-person-bounding-box"></i>
                    <span>Face</span>
                </a>
                <a href="/Admin/AppSimulator?tab=kundli" class="nav-tab-btn @(Model.ActiveTab == "kundli" ? "active" : "")">
                    <i class="bi bi-stars"></i>
                    <span>Kundli</span>
                </a>
                <a href="/Admin/AppSimulator?tab=wallet" class="nav-tab-btn @(Model.ActiveTab == "wallet" ? "active" : "")">
                    <i class="bi bi-wallet2"></i>
                    <span>Wallet</span>
                </a>
                <a href="/Admin/AppSimulator?tab=auth" class="nav-tab-btn @(Model.ActiveTab == "auth" ? "active" : "")">
                    <i class="bi bi-person-circle"></i>
                    <span>User</span>
                </a>
            </div>
        </div>
    </div>

    <!-- RIGHT: Detailed Testing Guide & API Quick Links -->
    <div class="col-lg-7 col-xl-8">
        <div class="cosmic-card mb-4">
            <div class="cosmic-card-header">
                <i class="bi bi-key me-2"></i>App Me Login Kaise Hota Hai? (Architecture Explained)
            </div>
            <div class="p-3">
                <p style="font-size:0.82rem; color:var(--text-primary);">
                    CyhAstro me do alag-alag login systems hain:
                </p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 border border-secondary rounded bg-dark h-100">
                            <strong class="text-gold d-block mb-1">1. Web Admin Portal Login:</strong>
                            <div style="font-size:0.75rem; color:var(--text-muted);">
                                - <strong>URL:</strong> <a href="/Admin/Login" class="text-gold">/Admin/Login</a><br>
                                - <strong>Auth Type:</strong> ASP.NET Core Cookie Auth (Role: <code>Admin</code>)<br>
                                - <strong>Credentials:</strong> <code>admin@cyhastro.com</code> / <code>Admin@123</code><br>
                                - <strong>Use:</strong> Users manage karna, Ledger audit, prices, settings badalna.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 border border-secondary rounded bg-dark h-100">
                            <strong class="text-teal d-block mb-1">2. Mobile App (User) Login:</strong>
                            <div style="font-size:0.75rem; color:var(--text-muted);">
                                - <strong>Endpoint:</strong> <code>POST /api/auth/login</code> & <code>POST /api/auth/register</code><br>
                                - <strong>Auth Type:</strong> JWT Bearer Token (Role: <code>User</code>)<br>
                                - <strong>Default Test:</strong> <code>tester@cyhastro.com</code> / <code>Test@123</code><br>
                                - <strong>Use:</strong> Mobile user scan karta hai, apni kundli dekhta hai, credits use karta hai.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Strict AI Image Upload Notice -->
        <div class="cosmic-card mb-4 border-warning">
            <div class="cosmic-card-header text-warning">
                <i class="bi bi-shield-check me-2"></i>AI Response & Image Upload Rules
            </div>
            <div class="p-3">
                <ul style="font-size:0.8rem; color:var(--text-primary); margin:0; padding-left:18px;">
                    <li class="mb-2">
                        <strong>Bina Photo Ke Scan Block Hai:</strong> Pehle simulator me convenience ke liye dummy test result fall back ho jata tha. Ab use hata diya gaya hai — <strong>Bina real photo upload kiye AI analyze nahi karega</strong>.
                    </li>
                    <li class="mb-2">
                        <strong>Asli Photo Kaise Analyze Hoti Hai:</strong> Jab aap JPG/PNG/WEBP photo select karke <strong>"Upload & Analyze"</strong> dabate hain, photo server par save hoti hai aur Google Gemini Flash Vision API ko stream ki jati hai. AI aapke haath ki lakiron ke pixels dekh kar report generate karta hai.
                    </li>
                    <li>
                        <strong>Uploaded Photo Preview:</strong> Result aane par simulator card me aapki uploaded photo ka preview bhi dikhega taki aap verify kar sakein.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

                                <path d="M 51 39 Q 53 41 55 39" stroke="#0f172a" stroke-width="0.7" fill="none" stroke-linecap="round" />

                                <!-- Gentle Divine Smile -->
                                <path d="M 48 43 Q 50 44.5 52 43" stroke="#0284c7" stroke-width="0.6" fill="none" stroke-linecap="round" />

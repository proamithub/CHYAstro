                                नया खाता बनाना चाहते हैं? 
                                <a href="javascript:switchAuthView('register')" class="text-warning text-decoration-none fw-bold">
                                    यहाँ क्लिक करें
                                </a>
                            </div>
                        </div>

                        <!-- ── SUB-VIEW 2: REGISTER FORM ── -->
                        <div id="authViewRegister" style="display:@(Model.AuthMode == "register" ? "block" : "none");">

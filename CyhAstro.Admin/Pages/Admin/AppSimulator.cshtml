@page "/Admin/AppSimulator"
@model CyhAstro.Admin.Pages.Admin.AppSimulatorModel
@{
    ViewData["Title"] = "📱 Live Mobile App Tester";
    ViewData["ActivePage"] = "AppSimulator";
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
}

<style>
    /* Phone frame simulation */
    .phone-mockup {
        width: 410px;
        max-width: 100%;
        min-height: 800px;
        background: #090517;
        border: 12px solid #1f1638;
        border-radius: 48px;
        box-shadow: 0 25px 65px rgba(0, 0, 0, 0.85), 0 0 50px rgba(124, 58, 237, 0.35);
        margin: 0 auto;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .phone-notch {
        width: 130px;
        height: 22px;
        background: #1f1638;
        margin: 0 auto;
        border-bottom-left-radius: 14px;
        border-bottom-right-radius: 14px;
        position: relative;
        z-index: 20;
    }
    .phone-screen {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        max-height: 740px;
        position: relative;
        background: radial-gradient(circle at 50% 20%, #170d38 0%, #090517 75%, #05020d 100%);
    }
    .phone-screen::-webkit-scrollbar {
        width: 4px;
    }
    .phone-screen::-webkit-scrollbar-thumb {
        background: rgba(255, 215, 0, 0.2);
        border-radius: 4px;
    }
    .phone-header {
        padding: 10px 14px;
        background: rgba(15, 10, 32, 0.85);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(255, 215, 0, 0.15);
    }
    .phone-bottom-nav {
        display: flex;
        justify-content: space-around;
        background: rgba(14, 9, 29, 0.95);
        backdrop-filter: blur(12px);
        border-top: 1px solid rgba(255, 215, 0, 0.2);
        padding: 8px 4px 12px;
        position: relative;
        z-index: 15;
    }
    .nav-tab-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 0.65rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        text-decoration: none;
        transition: all 0.25s ease;
    }
    .nav-tab-btn i { font-size: 1.15rem; }
    .nav-tab-btn.active { color: #f59e0b; font-weight: 700; transform: translateY(-2px); }
    .nav-tab-btn:hover { color: #f8fafc; }

    /* ═══════════════════════════════════════════════════
       COSMIC SHIVA & REVOLVING NAVAGRAHA SOLAR SYSTEM
       ═══════════════════════════════════════════════════ */
    .shiva-cosmic-stage {
        position: relative;
        width: 100%;
        height: 290px;
        overflow: hidden;
        background: radial-gradient(circle at 50% 50%, #1e1045 0%, #0c0620 60%, #05020e 100%);
        border-bottom: 1px solid rgba(255, 215, 0, 0.25);
        box-shadow: inset 0 -15px 30px rgba(0, 0, 0, 0.8);
    }

    /* Twinkling starfield */
    .cosmic-stars {
        position: absolute;
        inset: 0;
        background-image:
            radial-gradient(1px 1px at 20px 30px, #ffffff, transparent),
            radial-gradient(1.5px 1.5px at 70px 90px, #ffd700, transparent),
            radial-gradient(1px 1px at 150px 40px, #38bdf8, transparent),
            radial-gradient(1.5px 1.5px at 220px 110px, #ffffff, transparent),
            radial-gradient(1px 1px at 290px 50px, #f472b6, transparent),
            radial-gradient(1.5px 1.5px at 330px 150px, #ffffff, transparent),
            radial-gradient(1px 1px at 80px 220px, #38bdf8, transparent),
            radial-gradient(1.5px 1.5px at 180px 240px, #ffd700, transparent),
            radial-gradient(1px 1px at 260px 200px, #ffffff, transparent);
        background-size: 350px 300px;
        opacity: 0.65;
        animation: stars-twinkle 6s ease-in-out infinite alternate;
    }
    @@keyframes stars-twinkle {
        0% { opacity: 0.45; }
        100% { opacity: 0.85; }
    }

    /* Solar System Wrapper centered */
    .navagraha-solar-system {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        pointer-events: none;
    }

    /* Individual Concentric Planetary Orbit Rings */
    .orbit-ring {
        position: absolute;
        top: 50%;
        left: 50%;
        width: var(--orbit-size);
        height: var(--orbit-size);
        margin-top: calc(var(--orbit-size) / -2);
        margin-left: calc(var(--orbit-size) / -2);
        border: 1px dashed rgba(255, 215, 0, 0.16);
        border-radius: 50%;
        animation: orbit-rotate var(--orbit-speed) linear infinite;
    }
    .orbit-ring.reverse {
        animation: orbit-rotate-rev var(--orbit-speed) linear infinite;
    }
    .orbit-ring:hover {
        border-color: rgba(255, 215, 0, 0.4);
    }

    /* Planet Body */
    .planet-body {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        box-shadow: 0 0 10px currentColor;
    }

    /* Planet Specific Aesthetics */
    .planet-surya { width: 11px; height: 11px; background: radial-gradient(circle, #fff7ed, #f59e0b, #d97706); color: #f59e0b; box-shadow: 0 0 14px #f59e0b; }
    .planet-chandra { width: 8px; height: 8px; background: radial-gradient(circle, #ffffff, #e2e8f0, #94a3b8); color: #e2e8f0; box-shadow: 0 0 10px #ffffff; }
    .planet-budha { width: 7px; height: 7px; background: radial-gradient(circle, #a7f3d0, #10b981, #047857); color: #10b981; }
    .planet-shukra { width: 9px; height: 9px; background: radial-gradient(circle, #e0f2fe, #38bdf8, #0284c7); color: #38bdf8; box-shadow: 0 0 12px #38bdf8; }
    .planet-mangal { width: 8px; height: 8px; background: radial-gradient(circle, #fecaca, #ef4444, #b91c1c); color: #ef4444; box-shadow: 0 0 10px #ef4444; }
    .planet-guru { width: 13px; height: 13px; background: radial-gradient(circle, #fef08a, #eab308, #ca8a04); color: #eab308; box-shadow: 0 0 14px #eab308; }
    .planet-shani { width: 10px; height: 10px; background: radial-gradient(circle, #c7d2fe, #6366f1, #3730a3); color: #818cf8; position: relative; }
    .saturn-ring-disc {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 18px;
        height: 6px;
        border: 1.5px solid rgba(251, 191, 36, 0.85);
        border-radius: 50%;
        transform: translate(-50%, -50%) rotate(-25deg);
        pointer-events: none;
    }
    .planet-rahu { width: 7px; height: 7px; background: radial-gradient(circle, #f3e8ff, #a855f7, #6b21a8); color: #a855f7; box-shadow: 0 0 8px #a855f7; }
    .planet-ketu { width: 7px; height: 7px; background: radial-gradient(circle, #ffedd5, #f97316, #c2410c); color: #f97316; box-shadow: 0 0 8px #f97316; }

    @@keyframes orbit-rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    @@keyframes orbit-rotate-rev {
        from { transform: rotate(360deg); }
        to { transform: rotate(0deg); }
    }

    /* Meditating Lord Shiva Centerpiece */
    .shiva-divine-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 110px;
        height: 120px;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10;
        filter: drop-shadow(0 0 16px rgba(255, 215, 0, 0.5)) drop-shadow(0 0 28px rgba(56, 189, 248, 0.4));
        animation: divine-float 4s ease-in-out infinite alternate;
    }
    @@keyframes divine-float {
        0% { transform: translate(-50%, -50%) scale(0.98); }
        100% { transform: translate(-50%, -52%) scale(1.02); }
    }

    .shiva-aura-glow {
        position: absolute;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(251, 191, 36, 0.35) 0%, rgba(56, 189, 248, 0.25) 45%, transparent 75%);
        animation: aura-pulse 3s ease-in-out infinite alternate;
        z-index: 1;
    }
    @@keyframes aura-pulse {
        0% { transform: scale(0.9); opacity: 0.6; }
        100% { transform: scale(1.15); opacity: 0.95; }
    }

    /* Third Eye Glow */
    .third-eye-glow {
        animation: third-eye-pulse 2s ease-in-out infinite alternate;
    }
    @@keyframes third-eye-pulse {
        0% { opacity: 0.6; filter: drop-shadow(0 0 2px #38bdf8); }
        100% { opacity: 1; filter: drop-shadow(0 0 6px #f59e0b) drop-shadow(0 0 8px #38bdf8); }
    }

    /* Floating Cosmic Auth Glass Card */
    .cosmic-auth-card {
        background: rgba(18, 12, 38, 0.9);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 215, 0, 0.28);
        border-radius: 22px;
        padding: 18px 16px;
        margin: -25px 12px 16px 12px;
        position: relative;
        z-index: 12;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7), 0 0 25px rgba(245, 158, 11, 0.15);
    }

    .auth-tab-switch {
        display: flex;
        background: rgba(10, 6, 22, 0.85);
        border: 1px solid rgba(255, 215, 0, 0.2);
        border-radius: 30px;
        padding: 3px;
        margin-bottom: 16px;
    }
    .auth-tab-btn {
        flex: 1;
        padding: 8px 10px;
        border-radius: 26px;
        border: none;
        background: transparent;
        color: #94a3b8;
        font-size: 0.76rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s ease;
        text-align: center;
    }
    .auth-tab-btn.active {
        background: linear-gradient(135deg, #d97706, #f59e0b);
        color: #0b0717;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
    }

    /* Cosmic Inputs */
    .cosmic-input-group {
        position: relative;
        margin-bottom: 12px;
    }
    .cosmic-input-group i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #f59e0b;
        font-size: 0.85rem;
    }
    .cosmic-input-group .form-control {
        padding-left: 36px;
        background: rgba(15, 10, 30, 0.85);
        border: 1px solid rgba(255, 215, 0, 0.22);
        color: #f8fafc;
        border-radius: 12px;
        font-size: 0.8rem;
    }
    .cosmic-input-group .form-control:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 10px rgba(245, 158, 11, 0.3);
        background: rgba(20, 14, 40, 0.95);
        color: #fff;
    }

    .btn-cosmic-gold {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #0b0717;
        font-weight: 700;
        border: none;
        border-radius: 12px;
        padding: 9px 14px;
        font-size: 0.82rem;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.35);
        transition: all 0.2s;
    }
    .btn-cosmic-gold:hover {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #000;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(245, 158, 11, 0.5);
    }

    .btn-cosmic-demo {
        background: rgba(30, 20, 58, 0.7);
        border: 1px dashed rgba(245, 158, 11, 0.5);
        color: #fbbf24;
        font-size: 0.74rem;
        border-radius: 10px;
        padding: 6px 10px;
        transition: all 0.2s;
    }
    .btn-cosmic-demo:hover {
        background: rgba(245, 158, 11, 0.15);
        border-color: #f59e0b;
        color: #fff;
    }

    .planet-badge-chip {
        font-size: 0.62rem;
        padding: 2px 6px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
    }
</style>

@if (!string.IsNullOrEmpty(Model.AlertMessage))
{
    <div class="alert-cosmic mb-3 p-3 @(Model.AlertSuccess ? "border-success text-success" : "border-danger text-danger")" role="alert">
        @(Model.AlertSuccess ? "✨ " : "⚠️ ") @Model.AlertMessage
    </div>
}

<div class="row g-4">
    <!-- ══════════════════════════════════════════════════════
         LEFT COLUMN: INTERACTIVE SMARTPHONE APP SIMULATOR
         ══════════════════════════════════════════════════════ -->
    <div class="col-lg-5 col-xl-4 text-center">
        <div class="phone-mockup text-start">
            <div class="phone-notch"></div>
            
            <div class="phone-screen">
                <!-- TOP STATUS BAR -->
                <div class="phone-header">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span style="font-size:0.68rem; color:#94a3b8;"><i class="bi bi-clock me-1"></i>@(DateTime.Now.ToString("hh:mm tt"))</span>
                        <span class="badge @(Model.IsLoggedIn ? "bg-warning text-dark" : "bg-secondary")" style="font-size:0.65rem; border-radius:12px;">
                            @(Model.TestUserProfile?.Plan ?? "Guest")
                        </span>
                        <span style="font-size:0.68rem; color:#10b981;"><i class="bi bi-battery-full me-1"></i>100%</span>
                    </div>

                    <!-- Header user status & logout -->
                    <div class="d-flex justify-content-between align-items-center mt-2 px-1">
                        <div class="text-start">
                            <div style="font-family:'Cinzel', serif; font-size:0.95rem; color:#fbbf24; font-weight:700; letter-spacing:0.5px;">
                                ✦ CYHASTRO ✦
                            </div>
                            <div style="font-size:0.68rem; color:#94a3b8;">
                                @if (Model.IsLoggedIn)
                                {
                                    <span>यूजर: <strong class="text-light">@Model.TestUserProfile!.FullName</strong></span>
                                }
                                else
                                {
                                    <span class="text-warning">🔱 दिव्य शिव प्रवेश द्वार (Login Required)</span>
                                }
                            </div>
                        </div>

                        @if (Model.IsLoggedIn)
                        {
                            <form method="post" asp-page-handler="Logout" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size:0.65rem;" title="लॉगआउट करके शिव लॉगिन स्क्रीन पर जाएं">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="badge bg-dark border border-warning text-warning" style="font-size:0.62rem;">
                                ॐ नमः शिवाय
                            </span>
                        }
                    </div>

                    @if (Model.IsLoggedIn)
                    {
                        <div class="mt-2 d-flex justify-content-center gap-2">
                            <span class="badge bg-dark border border-secondary" style="font-size:0.64rem;">
                                ✋ Palm: <strong>@Model.TestUserProfile!.PalmScansRemaining</strong>
                            </span>
                            <span class="badge bg-dark border border-secondary" style="font-size:0.64rem;">
                                👤 Face: <strong>@Model.TestUserProfile!.FaceScansRemaining</strong>
                            </span>
                            <a href="/Admin/AppSimulator?tab=login" class="badge bg-dark border border-warning text-warning text-decoration-none" style="font-size:0.64rem;" title="शिव दृश्य देखें">
                                🕉️ Shiva View
                            </a>
                        </div>
                    }
                </div>

                <!-- ══════════════════════════════════════════════════════
                     SCREEN A: COSMIC SHIVA + REVOLVING NAVAGRAHA LOGIN
                     Visible when: !IsLoggedIn OR ActiveTab == 'login'
                     ══════════════════════════════════════════════════════ -->
                @if (!Model.IsLoggedIn || Model.ActiveTab == "login")
                {
                    <!-- 1. The Sacred Cosmic Stage (Shiva in Yoga Mudra + Revolving Navagraha) -->
                    <div class="shiva-cosmic-stage">
                        <div class="cosmic-stars"></div>

                        <!-- 9 Revolving Navagraha Solar Orbits -->
                        <div class="navagraha-solar-system">
                            <!-- Orbit 1: Surya (Sun - सूर्य) -->
                            <div class="orbit-ring" style="--orbit-size: 58px; --orbit-speed: 8s;" title="सूर्य (Sun)">
                                <div class="planet-body planet-surya"></div>
                            </div>
                            <!-- Orbit 2: Chandra (Moon - चंद्र) -->
                            <div class="orbit-ring" style="--orbit-size: 82px; --orbit-speed: 6s;" title="चंद्र (Moon)">
                                <div class="planet-body planet-chandra"></div>
                            </div>
                            <!-- Orbit 3: Budha (Mercury - बुध) -->
                            <div class="orbit-ring" style="--orbit-size: 106px; --orbit-speed: 9s;" title="बुध (Mercury)">
                                <div class="planet-body planet-budha"></div>
                            </div>
                            <!-- Orbit 4: Shukra (Venus - शुक्र) -->
                            <div class="orbit-ring" style="--orbit-size: 130px; --orbit-speed: 11s;" title="शुक्र (Venus)">
                                <div class="planet-body planet-shukra"></div>
                            </div>
                            <!-- Orbit 5: Mangal (Mars - मंगल) -->
                            <div class="orbit-ring" style="--orbit-size: 156px; --orbit-speed: 13s;" title="मंगल (Mars)">
                                <div class="planet-body planet-mangal"></div>
                            </div>
                            <!-- Orbit 6: Guru (Jupiter - गुरु / बृहस्पति) -->
                            <div class="orbit-ring" style="--orbit-size: 184px; --orbit-speed: 18s;" title="गुरु (Jupiter)">
                                <div class="planet-body planet-guru"></div>
                            </div>
                            <!-- Orbit 7: Shani (Saturn - शनि) -->
                            <div class="orbit-ring" style="--orbit-size: 214px; --orbit-speed: 24s;" title="शनि (Saturn)">
                                <div class="planet-body planet-shani">
                                    <div class="saturn-ring-disc"></div>
                                </div>
                            </div>
                            <!-- Orbit 8: Rahu (North Node - राहु) - Retrograde Reverse Orbit -->
                            <div class="orbit-ring reverse" style="--orbit-size: 244px; --orbit-speed: 15s;" title="राहु (Rahu)">
                                <div class="planet-body planet-rahu"></div>
                            </div>
                            <!-- Orbit 9: Ketu (South Node - केतु) - Retrograde Reverse Orbit -->
                            <div class="orbit-ring reverse" style="--orbit-size: 272px; --orbit-speed: 15s;" title="केतु (Ketu)">
                                <div class="planet-body planet-ketu"></div>
                            </div>
                        </div>

                        <!-- Central Deity: Lord Shiva in Meditative Yoga Mudra (पद्मासन / ध्यानावस्था) -->
                        <div class="shiva-divine-center">
                            <div class="shiva-aura-glow"></div>
                            <!-- Pure Sacred Vector Shiva in Padmasana -->
                            <svg viewBox="0 0 100 110" width="100" height="110" style="position:relative; z-index:5;" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <linearGradient id="shivaSkin" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#7dd3fc" />
                                        <stop offset="50%" stop-color="#38bdf8" />
                                        <stop offset="100%" stop-color="#0284c7" />
                                    </linearGradient>
                                    <linearGradient id="shivaGold" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#fef08a" />
                                        <stop offset="60%" stop-color="#f59e0b" />
                                        <stop offset="100%" stop-color="#b45309" />
                                    </linearGradient>
                                    <linearGradient id="hairGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#1e1b4b" />
                                        <stop offset="100%" stop-color="#090517" />
                                    </linearGradient>
                                    <radialGradient id="haloRadial" cx="50%" cy="50%" r="50%">
                                        <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.8" />
                                        <stop offset="60%" stop-color="#38bdf8" stop-opacity="0.4" />
                                        <stop offset="100%" stop-color="#090517" stop-opacity="0" />
                                    </radialGradient>
                                </defs>

                                <!-- Radiant Halo Behind Head -->
                                <circle cx="50" cy="38" r="26" fill="url(#haloRadial)" />
                                <circle cx="50" cy="38" r="20" stroke="url(#shivaGold)" stroke-width="0.8" stroke-dasharray="2 2" opacity="0.7" />

                                <!-- Trishul (त्रिशूल) & Damru on Right -->
                                <g transform="translate(18, 0)">
                                    <!-- Trishul Shaft -->
                                    <line x1="68" y1="12" x2="68" y2="98" stroke="url(#shivaGold)" stroke-width="1.8" stroke-linecap="round" />
                                    <!-- Center prong -->
                                    <path d="M 68 12 L 68 4 L 70 7 Z" fill="url(#shivaGold)" />
                                    <!-- Side curved prongs -->
                                    <path d="M 62 14 C 62 7, 68 10, 68 16 C 68 10, 74 7, 74 14" stroke="url(#shivaGold)" stroke-width="1.6" fill="none" stroke-linecap="round" />
                                    <!-- Damru (डमरू) tied to trishul -->
                                    <polygon points="65,36 71,36 68,40" fill="url(#shivaGold)" />
                                    <polygon points="65,44 71,44 68,40" fill="url(#shivaGold)" />
                                    <line x1="64" y1="38" x2="72" y2="42" stroke="#ef4444" stroke-width="0.7" />
                                </g>

                                <!-- Lotus Pedestal / Asana -->
                                <ellipse cx="50" cy="98" rx="34" ry="7" fill="#1e1b4b" stroke="url(#shivaGold)" stroke-width="0.9" />
                                <path d="M 22 98 Q 36 93 50 98 Q 64 93 78 98 Q 50 106 22 98 Z" fill="url(#shivaGold)" opacity="0.3" />

                                <!-- Folded Legs (पद्मासन - Padmasana) -->
                                <path d="M 22 93 C 24 82, 34 84, 48 88 C 44 88, 32 94, 22 93 Z" fill="url(#shivaSkin)" stroke="#0284c7" stroke-width="0.8" />
                                <path d="M 78 93 C 76 82, 66 84, 52 88 C 56 88, 68 94, 78 93 Z" fill="url(#shivaSkin)" stroke="#0284c7" stroke-width="0.8" />
                                <!-- Lotus Feet visible in Padmasana -->
                                <ellipse cx="38" cy="88" rx="4.5" ry="2.5" fill="#bae6fd" />
                                <ellipse cx="62" cy="88" rx="4.5" ry="2.5" fill="#bae6fd" />

                                <!-- Torso & Shoulders -->
                                <path d="M 36 54 C 36 50, 42 48, 50 48 C 58 48, 64 50, 64 54 C 64 68, 58 84, 50 84 C 42 84, 36 68, 36 54 Z" fill="url(#shivaSkin)" stroke="#0284c7" stroke-width="0.8" />

                                <!-- Rudraksha Mala across Chest -->
                                <path d="M 40 54 Q 50 68 60 54" stroke="url(#shivaGold)" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="1.5 2" />

                                <!-- Serene Arms in Dhyana Mudra (resting in lap) -->

                                @Html.AntiForgeryToken()

                                <div class="cosmic-input-group">
                                    <i class="bi bi-person"></i>
                                    <input type="text" name="fullName" class="form-control" placeholder="पूरा नाम (उदा. राहुल शर्मा)" required />
                                </div>

                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <div class="cosmic-input-group m-0">
                                            <i class="bi bi-envelope"></i>
                                            <input type="email" name="email" class="form-control" placeholder="ईमेल" />
                                        </div>
                                    </div>

                                <div class="cosmic-input-group">
                                    <i class="bi bi-shield-lock"></i>
                                    <input type="password" name="password" class="form-control" placeholder="पासवर्ड" value="Test@123" required autocomplete="current-password" />
                                </div>

                                <button type="submit" class="btn btn-cosmic-gold w-100 py-2 mb-2">
                                    <i class="bi bi-door-open-fill me-1"></i> ✦ प्रवेश करें (Sign In) ✦
                                </button>

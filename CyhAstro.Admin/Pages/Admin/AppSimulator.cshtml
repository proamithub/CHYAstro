                                        <div class="cosmic-input-group m-0">
                                            <i class="bi bi-phone"></i>
                                            <input type="tel" name="phone" class="form-control" placeholder="मोबाइल" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <div class="cosmic-input-group m-0">
                                            <i class="bi bi-key"></i>
                                            <input type="password" name="password" class="form-control" placeholder="पासवर्ड (Min 6)" value="Pass@123" required />
                                        </div>
                                    </div>

<script>
    // ── Screen Switcher ──
    function switchScreen(name) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));

        const screenMap = {
            'home': 'home', 'horoscope': 'horoscope',
            'kundli': 'kundli', 'chat': 'chat',
            'profile': 'profile', 'prashna': 'prashna'
        };
        const navMap = {
            'home': 'home', 'horoscope': 'horoscope',
            'kundli': 'kundli', 'chat': 'chat',
            'profile': 'profile', 'prashna': 'kundli'
        };

        const screenEl = document.getElementById('screen-' + name);
        const navEl = document.getElementById('nav-' + (navMap[name] || name));
        if (screenEl) screenEl.classList.add('active');
        if (navEl) navEl.classList.add('active');
    }

    // ── Number Grid ──
    const grid = document.getElementById('numberGrid');
    for (let i = 1; i <= 49; i++) {
        const btn = document.createElement('button');
        btn.className = 'num-btn';
        btn.textContent = i;
        btn.onclick = () => revealOracle(i, btn);
        grid.appendChild(btn);
    }

    function revealOracle(num, btn) {
        document.querySelectorAll('.num-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');

        const answers = [
            { emoji: '✅', text: 'हाँ — शुभ संकेत है', detail: 'आपकी प्रश्न कुंडली में सप्तम भाव का स्वामी शुभ स्थान पर है। बृहस्पति की दृष्टि अनुकूल है। आपका काम होगा।', color: '#22c55e' },
            { emoji: '⏳', text: 'समय लगेगा — धैर्य रखें', detail: 'अभी ग्रह स्थिति अनुकूल नहीं है, लेकिन 3-4 महीने बाद परिस्थितियां बदलेंगी। शनि की दृष्टि थोड़ी देरी करा रही है।', color: '#f59e0b' },
            { emoji: '❌', text: 'नहीं — इस समय सावधान', detail: 'वर्तमान ग्रह स्थिति आपके प्रश्न के अनुकूल नहीं है। राहु की स्थिति बाधा डाल रही है। थोड़ा इंतज़ार करें।', color: '#ef4444' },
        ];

        const idx = num % 3;
        const ans = answers[idx];

        document.getElementById('oracleEmoji').textContent = ans.emoji;
        document.getElementById('oracleAnswer').textContent = ans.text;
        document.getElementById('oracleAnswer').style.color = ans.color;
        document.getElementById('oracleDetail').textContent = ans.detail;
        document.getElementById('oracleResult').style.display = 'block';
        document.getElementById('oraclePrompt').style.display = 'none';

        document.getElementById('oracleResult').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function resetOracle() {
        document.querySelectorAll('.num-btn').forEach(b => b.classList.remove('selected'));
        document.getElementById('oracleResult').style.display = 'none';
        document.getElementById('oraclePrompt').style.display = 'block';
    }

    // ── Horo Period ──
    function setHoroPeriod(el) {
        document.querySelectorAll('[onclick^="setHoroPeriod"]').forEach(b => {
            b.style.background = 'rgba(255,255,255,0.05)';
            b.style.color = '#64748b';
            b.style.borderColor = 'rgba(255,255,255,0.1)';
        });
        el.style.background = 'rgba(245,158,11,0.2)';
        el.style.color = '#fbbf24';
        el.style.borderColor = 'rgba(245,158,11,0.4)';
    }

    // ── Chat ──
    function fillChat(text) {
        document.getElementById('chatInput').value = text;
        document.getElementById('chatInput').focus();
    }

    function sendChat() {
        const input = document.getElementById('chatInput');
        const text = input.value.trim();
        if (!text) return;

        const chatArea = document.querySelector('.chat-area');

        const userDiv = document.createElement('div');
        userDiv.innerHTML = `<div class="chat-sender" style="text-align:right;">आप</div><div class="chat-bubble user-msg">${text}</div>`;
        chatArea.appendChild(userDiv);

        input.value = '';

        setTimeout(() => {
            const aiDiv = document.createElement('div');
            aiDiv.innerHTML = `<div class="chat-sender">🤖 AI पंडित जी</div><div class="chat-bubble ai">वत्स, आपका प्रश्न समझ लिया। आपकी कुंडली के अनुसार बुध महादशा में यह विषय बहुत महत्वपूर्ण है। अधिक विस्तृत जानकारी के लिए VIP plan में जाएं जहाँ AI पंडित जी आपकी पूरी कुंडली के साथ उत्तर देंगे। 🙏</div>`;
            chatArea.appendChild(aiDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }, 1000);

        chatArea.scrollTop = chatArea.scrollHeight;
    }

    // Enter key for chat
    document.getElementById('chatInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') sendChat();
    });

    // ── Muhurat popup ──
    function showMuhurat() {
        alert('🗓️ मुहूर्त फीचर जल्द आ रहा है!\n\nशादी, गृह प्रवेश, वाहन, बिजनेस के लिए शुभ मुहूर्त।');
    }
</script>

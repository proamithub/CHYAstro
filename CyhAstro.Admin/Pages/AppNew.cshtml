@page "/AppNew"
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>CyhAstro — नया यूजर पैनल</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #05020e;
            font-family: 'Poppins', sans-serif;
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            justify-content: center;
        }

        .phone-shell {
            width: 100%;
            max-width: 420px;
            min-height: 100vh;
            background: #0b071c;
            position: relative;
            overflow-x: hidden;
            padding-bottom: 80px;
        }

        /* ══════════════════════ TOP HEADER ══════════════════════ */
        .top-header {
            background: rgba(10, 6, 25, 0.97);
            border-bottom: 1px solid rgba(255,215,0,0.2);
            padding: 12px 16px;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
        }

        /* ══════════════════════ BOTTOM NAV ══════════════════════ */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 420px;
            background: rgba(8, 4, 20, 0.98);
            border-top: 1px solid rgba(255,215,0,0.2);
            display: flex;
            justify-content: space-around;
            padding: 8px 0 16px;
            z-index: 200;
            backdrop-filter: blur(16px);
        }
        .nav-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            color: #64748b;
            font-size: 0.6rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            background: none;
            padding: 4px 8px;
            border-radius: 10px;
        }
        .nav-btn i { font-size: 1.3rem; }
        .nav-btn.active { color: #f59e0b; }
        .nav-btn.active i {
            filter: drop-shadow(0 0 6px #f59e0b88);
            transform: translateY(-2px);
        }

        /* ══════════════════════ SCREENS ══════════════════════ */
        .screen { display: none; padding: 0; }
        .screen.active { display: block; }

        /* ══════════════════════ HOME SCREEN ══════════════════════ */
        .hero-banner {
            background: linear-gradient(160deg, #1a0a3e 0%, #0d0528 50%, #0b071c 100%);
            padding: 20px 16px 16px;
            position: relative;
            overflow: hidden;
        }
        .hero-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 70% 30%, rgba(139,92,246,0.15) 0%, transparent 60%),
                        radial-gradient(ellipse at 20% 80%, rgba(245,158,11,0.1) 0%, transparent 50%);
        }
        .greeting-text {
            font-family: 'Cinzel', serif;
            font-size: 1.1rem;
            color: #fbbf24;
            font-weight: 700;
        }
        .sub-greeting { font-size: 0.72rem; color: #94a3b8; }

        /* Daily Briefing Card */
        .daily-card {
            margin: 0 16px 16px;
            background: linear-gradient(135deg, rgba(139,92,246,0.15) 0%, rgba(245,158,11,0.1) 100%);
            border: 1px solid rgba(255,215,0,0.3);
            border-radius: 20px;
            padding: 16px;
            position: relative;
            overflow: hidden;
        }
        .daily-card::before {
            content: '';
            position: absolute;
            top: -20px; right: -20px;
            width: 100px; height: 100px;
            background: radial-gradient(circle, rgba(245,158,11,0.15) 0%, transparent 70%);
            border-radius: 50%;
        }
        .daily-label {
            font-size: 0.65rem;
            color: #f59e0b;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        .daily-title {
            font-family: 'Cinzel', serif;
            font-size: 0.95rem;
            color: #fbbf24;
            margin-bottom: 12px;
        }
        .briefing-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 12px;
        }
        .brief-item {
            background: rgba(255,255,255,0.05);
            border-radius: 10px;
            padding: 8px 10px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.72rem;
        }
        .brief-item .dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .dot-green { background: #22c55e; box-shadow: 0 0 6px #22c55e88; }
        .dot-yellow { background: #f59e0b; box-shadow: 0 0 6px #f59e0b88; }
        .dot-red { background: #ef4444; box-shadow: 0 0 6px #ef444488; }
        .dot-pink { background: #ec4899; box-shadow: 0 0 6px #ec489988; }

        .lucky-row {
            display: flex;
            gap: 8px;
            margin-top: 4px;
        }
        .lucky-chip {
            background: rgba(245,158,11,0.15);
            border: 1px solid rgba(245,158,11,0.3);
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 0.65rem;
            color: #fbbf24;
        }
        .rahu-chip {
            background: rgba(239,68,68,0.1);
            border: 1px solid rgba(239,68,68,0.3);
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 0.65rem;
            color: #fca5a5;
        }
        .shub-chip {
            background: rgba(34,197,94,0.1);
            border: 1px solid rgba(34,197,94,0.3);
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 0.65rem;
            color: #86efac;
        }

        /* Section Header */
        .section-header {
            padding: 16px 16px 8px;
            font-size: 0.72rem;
            color: #f59e0b;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-header::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(245,158,11,0.2);
        }

        /* Feature Grid */
        .feature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 0 16px 8px;
        }
        .feat-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 14px 12px;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
            overflow: hidden;
        }
        .feat-card:hover, .feat-card:active {
            border-color: rgba(245,158,11,0.4);
            background: rgba(245,158,11,0.06);
            transform: scale(0.98);
        }
        .feat-card.premium::after {
            content: 'VIP';
            position: absolute;
            top: 8px; right: 8px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #0b0717;
            font-size: 0.5rem;
            font-weight: 800;
            padding: 2px 5px;
            border-radius: 4px;
        }
        .feat-card.new::after {
            content: 'NEW';
            position: absolute;
            top: 8px; right: 8px;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
            font-size: 0.5rem;
            font-weight: 800;
            padding: 2px 5px;
            border-radius: 4px;
        }
        .feat-emoji { font-size: 1.8rem; margin-bottom: 6px; display: block; }
        .feat-name { font-size: 0.72rem; font-weight: 600; color: #e2e8f0; }
        .feat-desc { font-size: 0.6rem; color: #64748b; margin-top: 2px; }

        /* Wide cards */
        .feat-card-wide {
            margin: 0 16px 10px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 14px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all 0.2s;
        }
        .feat-card-wide:hover { border-color: rgba(245,158,11,0.4); }
        .feat-card-wide .feat-emoji { font-size: 2.2rem; margin: 0; flex-shrink: 0; }
        .feat-card-wide .info .title { font-size: 0.82rem; font-weight: 600; color: #f8fafc; }
        .feat-card-wide .info .sub { font-size: 0.65rem; color: #64748b; margin-top: 2px; }
        .feat-card-wide .arrow { margin-left: auto; color: #475569; font-size: 1rem; }

        /* ══════════════════════ PRASHNA SCREEN ══════════════════════ */
        .prashna-hero {
            background: linear-gradient(180deg, #1a0535 0%, #0b071c 100%);
            padding: 24px 16px 20px;
            text-align: center;
        }
        .crystal-ball {
            font-size: 5rem;
            animation: float 3s ease-in-out infinite alternate;
            filter: drop-shadow(0 0 20px rgba(139,92,246,0.5));
        }
        @keyframes float {
            from { transform: translateY(0); }
            to { transform: translateY(-8px); }
        }
        .number-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
            padding: 0 16px 16px;
        }
        .num-btn {
            aspect-ratio: 1;
            border-radius: 10px;
            border: 1px solid rgba(139,92,246,0.3);
            background: rgba(139,92,246,0.08);
            color: #c4b5fd;
            font-size: 0.7rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
        }
        .num-btn:hover, .num-btn.selected {
            background: rgba(139,92,246,0.4);
            border-color: #a78bfa;
            color: white;
            transform: scale(1.1);
            box-shadow: 0 0 10px rgba(139,92,246,0.4);
        }
        .oracle-result {
            margin: 16px;
            background: linear-gradient(135deg, rgba(139,92,246,0.15), rgba(245,158,11,0.1));
            border: 1px solid rgba(139,92,246,0.4);
            border-radius: 20px;
            padding: 20px;
            text-align: center;
        }
        .oracle-answer {
            font-size: 2.5rem;
            margin-bottom: 8px;
        }
        .oracle-text {
            font-family: 'Cinzel', serif;
            font-size: 1.1rem;
            color: #c4b5fd;
            margin-bottom: 8px;
        }
        .oracle-detail { font-size: 0.75rem; color: #94a3b8; line-height: 1.6; }

        /* ══════════════════════ KUNDLI SCREEN ══════════════════════ */
        .kundli-score-card {
            margin: 16px;
            background: linear-gradient(135deg, #1a0535, #0d0528);
            border: 1px solid rgba(245,158,11,0.3);
            border-radius: 20px;
            padding: 20px;
        }
        .score-circle {
            width: 100px; height: 100px;
            border-radius: 50%;
            background: conic-gradient(#f59e0b calc(74% * 3.6deg), rgba(255,255,255,0.1) 0deg);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
            position: relative;
        }
        .score-inner {
            width: 80px; height: 80px;
            border-radius: 50%;
            background: #1a0535;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .score-num { font-size: 1.5rem; font-weight: 800; color: #fbbf24; line-height: 1; }
        .score-denom { font-size: 0.6rem; color: #64748b; }
        .score-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }
        .score-label { font-size: 0.72rem; color: #94a3b8; width: 80px; flex-shrink: 0; }
        .score-bar-bg {
            flex: 1;
            height: 6px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            overflow: hidden;
        }
        .score-bar-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 1s ease;
        }
        .score-val { font-size: 0.65rem; color: #fbbf24; width: 30px; text-align: right; }

        /* Mahadasha Timeline */
        .timeline-card {
            margin: 0 16px 16px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 16px;
        }
        .timeline-item {
            display: flex;
            gap: 12px;
            margin-bottom: 12px;
            position: relative;
        }
        .timeline-item:not(:last-child)::after {
            content: '';
            position: absolute;
            left: 15px; top: 32px;
            width: 1px; height: calc(100% + 4px);
            background: rgba(255,255,255,0.1);
        }
        .tl-dot {
            width: 32px; height: 32px;
            border-radius: 50%;
            background: rgba(245,158,11,0.15);
            border: 2px solid rgba(245,158,11,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            flex-shrink: 0;
        }
        .tl-dot.active {
            background: rgba(245,158,11,0.3);
            border-color: #f59e0b;
            box-shadow: 0 0 10px rgba(245,158,11,0.3);
        }
        .tl-title { font-size: 0.75rem; font-weight: 600; color: #f8fafc; }
        .tl-sub { font-size: 0.62rem; color: #64748b; }
        .tl-badge {
            background: rgba(245,158,11,0.2);
            color: #fbbf24;
            border-radius: 6px;
            padding: 1px 6px;
            font-size: 0.58rem;
        }

        /* ══════════════════════ HOROSCOPE SCREEN ══════════════════════ */
        .rashi-scroll {
            display: flex;
            gap: 10px;
            padding: 0 16px 12px;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .rashi-scroll::-webkit-scrollbar { display: none; }
        .rashi-pill {
            flex-shrink: 0;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 50px;
            padding: 6px 14px;
            font-size: 0.7rem;
            color: #94a3b8;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
        }
        .rashi-pill.selected {
            background: rgba(245,158,11,0.2);
            border-color: rgba(245,158,11,0.5);
            color: #fbbf24;
        }
        .horoscope-card {
            margin: 0 16px 12px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            overflow: hidden;
        }
        .horo-header {
            background: linear-gradient(135deg, rgba(245,158,11,0.15), rgba(139,92,246,0.1));
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .rashi-icon { font-size: 2.5rem; }
        .horo-rashi-name { font-family: 'Cinzel', serif; font-size: 1rem; color: #fbbf24; }
        .horo-date { font-size: 0.65rem; color: #94a3b8; }
        .horo-tabs {
            display: flex;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .horo-tab {
            flex: 1;
            padding: 8px;
            font-size: 0.65rem;
            font-weight: 600;
            color: #64748b;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            background: none;
        }
        .horo-tab.active {
            color: #f59e0b;
            border-bottom: 2px solid #f59e0b;
        }
        .horo-body { padding: 14px 16px; }
        .horo-category {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
            align-items: flex-start;
        }
        .horo-cat-icon {
            font-size: 1.1rem;
            margin-top: 1px;
            flex-shrink: 0;
        }
        .horo-cat-title { font-size: 0.7rem; font-weight: 600; color: #e2e8f0; }
        .horo-cat-text { font-size: 0.65rem; color: #94a3b8; line-height: 1.5; margin-top: 2px; }

        /* ══════════════════════ PROFILE SCREEN ══════════════════════ */
        .profile-header {
            background: linear-gradient(160deg, #1a0a3e, #0b071c);
            padding: 24px 16px 20px;
            text-align: center;
        }
        .avatar-ring {
            width: 80px; height: 80px;
            border-radius: 50%;
            border: 2px solid #f59e0b;
            padding: 3px;
            margin: 0 auto 12px;
            box-shadow: 0 0 20px rgba(245,158,11,0.3);
        }
        .avatar-inner {
            width: 100%; height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg, #7c3aed, #2563eb);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }
        .plan-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #0b0717;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.65rem;
            font-weight: 800;
        }
        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            margin: 0 16px 16px;
        }
        .stat-box {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 12px 8px;
            text-align: center;
        }
        .stat-num { font-size: 1.3rem; font-weight: 800; color: #fbbf24; }
        .stat-label { font-size: 0.58rem; color: #64748b; margin-top: 2px; }
        .menu-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            cursor: pointer;
            transition: all 0.2s;
        }
        .menu-item:hover { background: rgba(255,255,255,0.03); }
        .menu-icon {
            width: 36px; height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .menu-label { font-size: 0.78rem; font-weight: 500; color: #e2e8f0; }
        .menu-sub { font-size: 0.62rem; color: #64748b; margin-top: 1px; }
        .menu-arrow { margin-left: auto; color: #475569; }

        /* Upgrade Banner */
        .upgrade-banner {
            margin: 0 16px 16px;
            background: linear-gradient(135deg, #7c3aed, #2563eb);
            border-radius: 16px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .upgrade-text .title { font-size: 0.85rem; font-weight: 700; color: white; }
        .upgrade-text .sub { font-size: 0.65rem; color: rgba(255,255,255,0.7); margin-top: 2px; }
        .upgrade-btn {
            margin-left: auto;
            background: white;
            color: #7c3aed;
            border: none;
            border-radius: 10px;
            padding: 8px 14px;
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
            cursor: pointer;
        }

        /* Tab indicator animation */
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .live-dot {
            width: 6px; height: 6px;
            background: #22c55e;
            border-radius: 50%;
            animation: pulse-dot 1.5s infinite;
            display: inline-block;
            margin-right: 4px;
        }

        /* ══════════════════════ CHAT / AI ══════════════════════ */
        .chat-area {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 300px;
        }
        .chat-bubble {
            max-width: 85%;
            padding: 10px 14px;
            border-radius: 16px;
            font-size: 0.75rem;
            line-height: 1.6;
        }
        .chat-bubble.ai {
            background: rgba(139,92,246,0.15);
            border: 1px solid rgba(139,92,246,0.25);
            color: #e2e8f0;
            border-top-left-radius: 4px;
            align-self: flex-start;
        }
        .chat-bubble.user-msg {
            background: rgba(245,158,11,0.15);
            border: 1px solid rgba(245,158,11,0.25);
            color: #fbbf24;
            border-bottom-right-radius: 4px;
            align-self: flex-end;
        }
        .chat-sender {
            font-size: 0.6rem;
            color: #64748b;
            margin-bottom: 4px;
        }
        .chat-input-row {
            position: sticky;
            bottom: 72px;
            padding: 10px 16px;
            background: rgba(8,4,20,0.95);
            border-top: 1px solid rgba(255,255,255,0.06);
            display: flex;
            gap: 8px;
            backdrop-filter: blur(10px);
        }
        .chat-input {
            flex: 1;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            padding: 10px 16px;
            color: #f8fafc;
            font-size: 0.78rem;
            outline: none;
            font-family: 'Poppins', sans-serif;
        }
        .chat-input::placeholder { color: #475569; }
        .chat-send {
            width: 42px; height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            border: none;
            color: #0b0717;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Suggested questions */
        .suggest-scroll {
            display: flex;
            gap: 8px;
            padding: 0 16px 10px;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .suggest-scroll::-webkit-scrollbar { display: none; }
        .suggest-pill {
            flex-shrink: 0;
            background: rgba(139,92,246,0.1);

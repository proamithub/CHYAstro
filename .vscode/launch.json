{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Admin Portal (Port 5066)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/CyhAstro.Admin/bin/Debug/net9.0/CyhAstro.Admin.dll",
            "args": ["--launch-profile", "http"],
            "cwd": "${workspaceFolder}/CyhAstro.Admin",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Run REST API (Port 5176)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/CyhAstro.Api/bin/Debug/net9.0/CyhAstro.Api.dll",
            "args": ["--launch-profile", "http"],
            "cwd": "${workspaceFolder}/CyhAstro.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}
